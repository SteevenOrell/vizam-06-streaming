[gate shuts]

4
00:00:34.500 --> 00:00:35.667
[spraying]

5
00:00:37.750 --> 00:00:38.775
[security guard grunting]

6
00:00:39.146 --> 00:00:39.542
[groaning]

7
00:00:39.583 --> 00:00:40.229
[stops groaning]

8
00:00:54.776 --> 00:00:55.100
[gasps]

9
00:00:55.522 --> 00:00:56.077
[grunts]

10
00:00:56.730 --> 00:00:57.292
[groans]

11
00:00:58.830 --> 00:01:01.938
-[alarm beeping]
-[dramatic music playing]

12
00:01:05.083 --> 00:01:05.810
[gasps fearfully]

13
00:01:12.771 --> 00:01:14.375
[dramatic, intense music playing]

14
00:01:37.833 --> 00:01:38.958
